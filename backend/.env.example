# Copy to .env and edit. Everything is optional — NexMind runs offline with zero configuration.
NEXMIND_LLM_PROVIDER=openai     # or anthropic / ollama
OPENAI_API_KEY=your-OPENAI_API_KEY
NEXMIND_HOST=127.0.0.1
NEXMIND_PORT=8000
NEXMIND_DATA_DIR=./data
# Origins allowed to call the API (your frontend dev server). Use * for development.
NEXMIND_CORS_ORIGINS=*

# --- LLM (leave unset for fully offline extractive answers) ---
# NEXMIND_LLM_PROVIDER=anthropic      # anthropic | openai | ollama | offline
# NEXMIND_LLM_MODEL=                  # defaults: claude-sonnet-5-5 | gpt-4o-mini | llama3.1
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
# NEXMIND_LLM_EXTRACT=false           # true = LLM entity/relation extraction while building the graph

# --- retrieval ---
# NEXMIND_EMBEDDINGS=tfidf            # tfidf (default, no downloads) | sentence-transformers

# --- limits ---
# NEXMIND_MAX_UPLOAD_MB=300
# NEXMIND_MAX_UNZIPPED_MB=1500
# NEXMIND_MAX_FILES=25000
# NEXMIND_GIT_HOSTS=github.com,gitlab.com,bitbucket.org,codeberg.org
# NEXMIND_STREAM_DELAY=0.04           # seconds between graph batches (the "graph grows live" pacing)

# --- hosted web app (Vercel) + local server ---
# Where your frontend lives; printed by `nexmind serve` and opened by `nexmind serve --open`
# NEXMIND_WEB_URL=http://localhost:5173
# Let the "Local folder" tab index folders on this machine in place (loopback requests only)
# NEXMIND_ALLOW_LOCAL_PATHS=true

# --- frontend environment variables (set in Vercel project settings) ---
# VITE_API_URL   — pre-set the backend URL shown in the "Start your server" screen.
#                  Leave unset; users enter their own server address via the Connect UI.
# VITE_SITE_URL  — public URL of the deployed site (shown on the landing page).
